{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom", "node"],
    "noEmit": true
  },
  // Standalone typecheck of the test suites: it pulls in `src` too, so tests are
  // checked against the real components rather than against emitted declarations.
  "include": ["src", "tests", "vite.config.ts", "playwright.config.ts"]
}
