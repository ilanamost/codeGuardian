# Template for the frontend development settings (local `npm run dev`).
# Written without the leading dot; the owner renames it (see deployment.md, "Rename after generation").
# Placeholder values only. Never put a secret in a VITE_* variable: Vite copies every VITE_* value into the public bundle.

# Public, not a secret. The backend base URL the browser calls. No trailing slash.
VITE_API_URL=http://localhost:3001

# Public, not a secret. The sub-path the app is served from. Leave it as "/" for local development.
VITE_BASE_PATH=/
