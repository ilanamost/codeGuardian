# Template for the development layer (NODE_ENV=development). Copy it to the real
# per-environment env file name next to the base file, then edit. Not secret unless stated.

# Port the API listens on. Not secret.
PORT=3001
# Exact origin of the local web app; no path. Not secret.
FRONTEND_URL=http://localhost:5173
# Local PostgreSQL connection string; blank means the in-memory store. SECRET (has a password).
DATABASE_URL='postgresql://user:password@localhost/dbname'
# Same-site local development: keep lax. Not secret.
COOKIE_SAMESITE=lax
# Bearer-token session fallback (on or off). Keep off locally unless you test the fallback. Not secret.
SESSION_TOKEN_FALLBACK=off
# Anthropic API key; blank means the stub analyzer. SECRET.
ANTHROPIC_API_KEY=
# Claude model id used for reviews; blank means the built-in default. Not secret.
ANTHROPIC_MODEL=
# GitHub OAuth App client id; set all three GITHUB_OAUTH_* or none. Not secret.
GITHUB_OAUTH_CLIENT_ID=
# GitHub OAuth App client secret. SECRET.
GITHUB_OAUTH_CLIENT_SECRET=
# Callback URL registered in the OAuth App. Not secret.
GITHUB_OAUTH_REDIRECT_URL=http://localhost:3001/api/auth/github/callback
