# Template for the production layer (NODE_ENV=production). Every value below is a placeholder.
# Copy it to the real per-environment env file name next to the base file, then fill it in on
# the server only. Never commit the real file. Not secret unless stated.

# Makes the layer for production load, and turns on Secure cookies and the __Host- name. Not secret.
NODE_ENV=production
# Port the API listens on (the host often sets it). Not secret.
PORT=3001
# The full address of the web app. A user site is the origin alone (https://your-user.github.io);
# a project page keeps its path (https://your-user.github.io/repo-name) and it must match the
# frontend base path (VITE_BASE_PATH). No query, no fragment; a trailing slash is ignored. Only
# its origin is the allowed CORS and CSRF origin; the path is used to send the browser back into
# the app after GitHub sign-in. Not secret.
FRONTEND_URL=https://your-user.github.io
# SameSite of the session and sign-in state cookies. `none` is needed when the web app (Pages)
# and the API are on different sites; it is accepted only with NODE_ENV=production and needs
# HTTPS. Not secret.
COOKIE_SAMESITE=none
# Bearer-token session fallback for browsers that block the third-party cookie (Safari on
# iPhone). `on` lets sign-in and registration return `sessionToken` to a client that asks for it;
# `off` (default) changes nothing. Read deployment.md section 7 first. Not secret.
SESSION_TOKEN_FALLBACK=off
# Production PostgreSQL connection string. SECRET.
DATABASE_URL='postgresql://user:password@db.example.com/dbname'
# Anthropic API key; blank means the stub analyzer. SECRET.
ANTHROPIC_API_KEY=
# Claude model id used for reviews; blank means the built-in default. Not secret.
ANTHROPIC_MODEL=
# GitHub token for the Integration wizard and the link import (5000 requests an hour instead of 60);
# blank means no token. Create one with no scopes on GitHub; set it on the host only. SECRET.
GITHUB_API_TOKEN=
# Number of proxy hops in front of the API; set 1 on Render (one proxy); blank or 0 = off. Not secret.
TRUST_PROXY=
# GitHub OAuth App client id; set all three GITHUB_OAUTH_* or none. Not secret.
GITHUB_OAUTH_CLIENT_ID=
# GitHub OAuth App client secret. SECRET.
GITHUB_OAUTH_CLIENT_SECRET=
# Callback URL registered in the OAuth App (the public API origin). Not secret.
GITHUB_OAUTH_REDIRECT_URL=https://api.example.com/api/auth/github/callback
