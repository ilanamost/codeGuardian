{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "description": "AI Code Reviewer backend: Express API over PostgreSQL (DATABASE_URL), or an in-memory store without it",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "predev": "npm run db:setup",
    "dev": "tsx watch src/index.ts",
    "prestart": "npm run db:setup",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:setup": "tsx db/setup.ts",
    "db:setup:test": "tsx db/setup.ts --test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "cors": "^2.8.6",
    "express": "^4.22.2",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "ajv": "^8.20.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "yaml": "^2.9.1"
  }
}
