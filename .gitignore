# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Env / secrets (patterns match in any directory, incl. backend/)
.env
.env.*
!.env.example
# Any template ending in the example suffix is tracked (the per-environment templates, plan 042)
!*.example

# Build output
dist/
build/
frontend/dist/
backend/build/
*.tsbuildinfo

# Test / tooling artifacts
coverage/
playwright-report/
test-results/
.vitest/

# Logs
*.log
npm-debug.log*

# Editor / OS
.DS_Store
Thumbs.db
.idea/

# Agent run artifacts (generated during orchestration)
.orchestration/*-report.md
.orchestration/FINAL-REPORT.md
.orchestration/qa-report.md
.plan/000-backlog.md

# Agent guardrail/config and docs directories
.claude/
# Everything under .github/ except workflows/ — real deployment infra (e.g.
# deploy-pages.yml) needs to be trackable and pushed; only workflows/ is
# carved out of the exclusion below.
.github/*
!.github/workflows/
.rule/
.doc/

# Agent instruction and orchestration files
AGENTS.md
CLAUDE.md
dev-loop.js
dev-loop.prompt.md
trace-agent.js
.orchestrate/
# Other agent rules (Cursor)
.cursor/
